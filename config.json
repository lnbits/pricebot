{
  "id": "pricebot",
  "name": "Pricebot",
  "short_description": "Bitcoin price alerts and a daily summary, powered by LNbits.",
  "version": "0.1.0",
  "min_lnbits_version": "1.5.6",
  "extension_type": "wasm",
  "tile": "/ext-assets/pricebot/icon.svg",
  "wasm": {
    "module": "wasm/module.wasm",
    "exports": [
      {
        "name": "get-state",
        "visibility": "authenticated"
      },
      {
        "name": "get-history",
        "visibility": "authenticated"
      },
      {
        "name": "save-preferences",
        "visibility": "authenticated"
      },
      {
        "name": "save-alert",
        "visibility": "authenticated"
      },
      {
        "name": "delete-alert",
        "visibility": "authenticated"
      },
      {
        "name": "collect-prices",
        "visibility": "event"
      },
      {
        "name": "check-alerts",
        "visibility": "event"
      },
      {
        "name": "daily-summary",
        "visibility": "event"
      }
    ]
  },
  "ui_routes": [
    {
      "path": "/pricebot",
      "entrypoint": "ui/index.html",
      "auth": "user"
    }
  ],
  "api_routes": [
    {
      "method": "GET",
      "path": "/state",
      "export": "get-state",
      "auth": "user"
    },
    {
      "method": "GET",
      "path": "/history",
      "export": "get-history",
      "auth": "user"
    },
    {
      "method": "PUT",
      "path": "/preferences",
      "export": "save-preferences",
      "auth": "user"
    },
    {
      "method": "POST",
      "path": "/alerts",
      "export": "save-alert",
      "auth": "user"
    },
    {
      "method": "PUT",
      "path": "/alerts/{alert_id}",
      "export": "save-alert",
      "auth": "user",
      "path_params": {
        "alert_id": "alertId"
      }
    },
    {
      "method": "DELETE",
      "path": "/alerts/{alert_id}",
      "export": "delete-alert",
      "auth": "user",
      "path_params": {
        "alert_id": "alertId"
      }
    }
  ],
  "permissions": [
    {
      "id": "utils.basic",
      "description": "Read the BTC/USD price from core exchange rates."
    },
    {
      "id": "ext.storage.read",
      "description": "Read Pricebot history in its collector context and your private alerts, preferences, and notification state."
    },
    {
      "id": "ext.storage.write",
      "description": "Store shared price history from the collector and private alerts, preferences, and notification state for each user."
    },
    {
      "id": "notifications.send_user_notification",
      "description": "Send price alerts and optional daily summaries through your saved LNbits notification settings."
    },
    {
      "id": "scheduler.user",
      "description": "Check your alerts every minute and optionally send your daily summary at 09:00 UTC.",
      "policies": [
        {
          "handler": "check-alerts",
          "cron_expression": "* * * * *",
          "timezone": "UTC"
        },
        {
          "handler": "daily-summary",
          "cron_expression": "0 9 * * *",
          "timezone": "UTC"
        }
      ]
    },
    {
      "id": "ext.storage.read_public",
      "description": "Read the common BTC/USD price history. Alerts and account preferences stay private.",
      "policies": [
        {
          "table_name": "history",
          "source_id_field": "series",
          "public_fields": [
            "id",
            "series",
            "resolution",
            "start",
            "buckets_json"
          ]
        }
      ]
    }
  ]
}
